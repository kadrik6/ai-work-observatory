#!/bin/sh
# Turvakontroll enne iga commit'i: kontrollib lisatud failide sisu Giti indeksist.
# Lülita igas arvutis üks kord sisse: git config core.hooksPath .githooks
python3 turvakontroll/kontrolli.py --staged || {
  echo "Commit peatatud: turvakontroll leidis vea (vt üleval). Ära kasuta --no-verify." >&2
  exit 1
}
